# Deployment-local authoring layers/plugins appended to authoring.config.yaml.
# Ignored on purpose: it names extensions that live in their own repositories
# and that this one must not declare.
authoring.config.local.yaml

# Compiler-generated artifacts (recreate with `bun run generate`)
apps/api/src/generated/connectors/
apps/api/src/generated/db/
apps/api/src/generated/graphql/
apps/api/src/generated/mcp/
apps/api/src/generated/modules/
apps/api/src/generated/operations/
apps/api/src/generated/page-configs/
apps/api/src/generated/plugin-migrations/
apps/api/src/generated/rest/
apps/api/src/generated/workflow/
apps/api/src/generated/workflow-domain-nodes/
apps/web/src/actions/generated/
apps/web/src/app/(generated)/
# Routes plugins emit. One directory per plugin, each declared in that plugin's
# ownedPaths so the stale/orphan gates sweep it.
apps/web/src/app/(plugins)/
apps/web/src/app/layout.tsx
apps/web/src/app/page.tsx
apps/web/src/compiler/
apps/web/src/generated/
apps/web/src/features/renderer/generated/
apps/web/src/features/workflow/lib/nodes/generated/
apps/web/src/lib/core-referentiedata-by-groep.json
keycloak/*-realm.json
cookies.txt
.authoring-build/
.e2e-report/
.perf-report/
docs/entities.generated.md

# Browser e2e. `.auth/` holds a live signed-in session cookie for whatever realm
# the run was pointed at, which is precisely the thing that must never be
# committed; the other two are traces and screenshots from a failed run.
apps/web/e2e/.auth/
apps/web/test-results/
apps/web/playwright-report/
