# Copy to apps/admin/.env before `bun run dev:admin`.
# Defaults below match the docker-compose.local.yml stack.
#
# READ THIS FIRST: apps/admin authenticates against the CONTROL realm
# (openshapeforge-control), not the tenant realm apps/web uses. The two apps
# are different audiences and share nothing but the Keycloak server and the
# Redis instance. Pointing this app at the tenant realm is a misconfiguration,
# not a shortcut — tenant users are not platform operators.

# --- Auth (NextAuth + Keycloak, CONTROL realm) ------------------------------
# Any random string; `openssl rand -base64 32` is fine for local dev. It must
# NOT be the same value apps/web uses: the two apps share the localhost cookie
# jar, and distinct secrets mean neither app can even read the other's cookie.
AUTH_SECRET=openshapeforge-local-dev-admin-auth-secret
# Must match a client in packages/compiler/config/authoring/authorization.control.yaml.
AUTH_KEYCLOAK_ID=openshapeforge-admin-gateway
# That gateway client's dev-only secret from the same file.
AUTH_KEYCLOAK_SECRET=admin-dev-secret
# Realm name comes from authorization.control.yaml (`realm.name`); the compose
# stack publishes Keycloak on 8181.
AUTH_KEYCLOAK_ISSUER=http://localhost:8181/realms/openshapeforge-control
# Set ONLY when the browser and the server reach Keycloak on different hosts
# (e.g. the app runs in a container). Leave it COMMENTED OUT rather than empty:
# the code falls back with `??`, which an empty string satisfies, so
# `AUTH_KEYCLOAK_ISSUER_INTERNAL=` would win over AUTH_KEYCLOAK_ISSUER and
# produce a relative URL. The same applies to every optional var below.
#AUTH_KEYCLOAK_ISSUER_INTERNAL=
# 3002 is not a preference. The control realm allow-lists http://localhost:3002/*
# as this client's only app redirect URI; another port fails at Keycloak.
AUTH_URL=http://localhost:3002
# Cookies stay non-secure over plain http on localhost.
AUTH_COOKIE_SECURE=false
#AUTH_COOKIE_DOMAIN=

# --- Session store ----------------------------------------------------------
# Required. The session payload lives here; the cookie holds only its id.
# Shared Redis with apps/web, but a disjoint key prefix — see src/lib/auth/redis.ts.
REDIS_URL=redis://localhost:6379

# --- Control API (apps/api control surface, issue #289) ---------------------
# Where the tenant/sub-org control surface lives. 127.0.0.1 rather than
# localhost so Node's fetch does not prefer ::1 while the API binds IPv4-only.
# Nothing calls it yet; see src/lib/clients/control-api.ts.
OPENSHAPEFORGE_CONTROL_API_URL=http://127.0.0.1:3001

# --- Keycloak SPI (TENANT realm, server-side only) --------------------------
# Cross-realm is forced, not chosen: the SPI authenticates its bearer against
# the TARGET realm, so this app's control-realm token can never call it. These
# name the service account that can. See src/lib/clients/keycloak-spi.ts.
# Unset by default — as of S3 the provisioning SPI calls are made API-side.
#OPENSHAPEFORGE_TENANT_REALM_ISSUER=http://localhost:8181/realms/openshapeforge
#OPENSHAPEFORGE_SPI_CLIENT_ID=openshapeforge-auth-api
#OPENSHAPEFORGE_SPI_CLIENT_SECRET=openshapeforge-auth-api-secret
