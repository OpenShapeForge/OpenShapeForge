# --- Server -----------------------------------------------------------------
# Which role src/index.ts starts. "api" (the default) is the fastify server;
# any other value names a worker role a runtime module contributes — the
# workflow plugin contributes "workflow-worker", one process draining
# workflow.control_commands. See docs/plugins.md#worker-roles.
OPENSHAPEFORGE_ROLE=api
# Port/host the fastify api role listens on (src/roles/api.ts). Unused by a
# worker role, which serves no traffic.
PORT=3001
HOST=0.0.0.0
# Set to "production" to disable GraphiQL on /api/graphql (src/graphql/yoga.ts).
NODE_ENV=development

# --- GraphQL browser policy -------------------------------------------------
# REQUIRED for the API role. Choose "disabled" for no CORS response headers,
# or "allowlist" plus exact comma-separated HTTP(S) origins. There is no
# permissive default. Credentials remain false unless explicitly enabled.
OPENSHAPEFORGE_GRAPHQL_CORS_MODE=allowlist
OPENSHAPEFORGE_GRAPHQL_CORS_ORIGINS=http://localhost:3000
OPENSHAPEFORGE_GRAPHQL_CORS_CREDENTIALS=false

# --- OpenTelemetry traces ---------------------------------------------------
# Tracing is disabled unless an OTLP endpoint is explicitly configured. Non-
# localhost endpoints must use HTTPS. The SDK loads before Fastify/database.
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel.example.com/v1/traces
#OTEL_SERVICE_NAMESPACE=example

# --- Postgres ---------------------------------------------------------------
# APP RUNTIME connection. Uses the RESTRICTED, non-superuser `openshapeforge_app`
# role so FORCE ROW LEVEL SECURITY is actually enforced by Postgres (a
# superuser silently bypasses every RLS policy). Provisioned idempotently by
# db:migrate. The api role starts without it but serves GraphQL with
# DATABASE_NOT_CONFIGURED errors.
DATABASE_URL=postgres://openshapeforge_app:openshapeforge_app@localhost:5434/openshapeforge_dev

# PRIVILEGED MIGRATE connection. db:migrate uses this to CREATE ROLE, run DDL,
# and GRANT — none of which the restricted runtime role can do. Falls back to
# DATABASE_URL only if unset (then restricted DDL fails loudly, by design).
OPENSHAPEFORGE_MIGRATE_DATABASE_URL=postgres://openshapeforge:openshapeforge@localhost:5434/openshapeforge_dev

# Password for the restricted `openshapeforge_app` role. db:migrate provisions
# the role with THIS value on first creation only (it never force-resets an
# existing role's password), so it must match the password in DATABASE_URL
# above. Optional in dev/test (defaults to `openshapeforge_app`, the value used
# in DATABASE_URL here); REQUIRED and must be a strong, randomized secret when
# NODE_ENV=production — the app refuses to migrate otherwise, and the dev
# default is rejected. To rotate an already-provisioned role, set
# OPENSHAPEFORGE_APP_PASSWORD_ROTATE=1 for a single migrate run with the new
# value (and update DATABASE_URL in lockstep).
#OPENSHAPEFORGE_APP_PASSWORD=openshapeforge_app
#OPENSHAPEFORGE_APP_PASSWORD_ROTATE=

# WORKER RUNTIME connection, for OPENSHAPEFORGE_ROLE=<a worker role>. Uses the
# SECOND restricted role, `openshapeforge_worker`, which is what the workflow
# queue policies compare `current_user` against:
#
#   USING (app.bypass_rls()
#          OR (current_user = 'openshapeforge_worker'
#              AND app.current_worker_role() = 'workflow-worker')
#          OR (tenant_id = app.current_tenant()))
#
# A worker role process REQUIRES this and never falls back to DATABASE_URL
# (src/roles/worker.ts refuses, including when it is set to the same value):
# connecting with the API's credentials would drain nothing while reporting
# healthy, and would put both processes back on one database identity. Unused
# by the api role. Provisioned idempotently by db:migrate, with DML on only the
# tables a worker touches — never the platform control plane.
OPENSHAPEFORGE_WORKER_DATABASE_URL=postgres://openshapeforge_worker:openshapeforge_worker@localhost:5434/openshapeforge_dev

# Password for the restricted `openshapeforge_worker` role. Same contract as
# OPENSHAPEFORGE_APP_PASSWORD: applied on first creation only, optional in
# dev/test (defaults to `openshapeforge_worker`, the value used in the URL
# above), REQUIRED and randomized under NODE_ENV=production, rotated by setting
# OPENSHAPEFORGE_WORKER_PASSWORD_ROTATE=1 for a single migrate run. Keep it
# DISTINCT from OPENSHAPEFORGE_APP_PASSWORD — one credential for both roles is
# one credential.
#OPENSHAPEFORGE_WORKER_PASSWORD=openshapeforge_worker
#OPENSHAPEFORGE_WORKER_PASSWORD_ROTATE=

# --- Keycloak bearer verification (src/auth/identity.ts) --------------------
# When JWKS URI + issuer are unset, bearer tokens are ignored and the session
# falls back to trusted-context headers. AUDIENCE is now required: without it,
# any same-issuer Keycloak token is accepted (identity.ts logs a dev warning;
# production-guard.ts makes it fatal in prod). The value must appear in the
# token's `aud` claim — for the openshapeforge-gateway dev client that includes
# `erp-provider`.
OPENSHAPEFORGE_API_VERIFY_BEARER_JWKS_URI=http://localhost:8181/realms/openshapeforge/protocol/openid-connect/certs
OPENSHAPEFORGE_API_VERIFY_BEARER_ISSUER=http://localhost:8181/realms/openshapeforge
OPENSHAPEFORGE_API_VERIFY_BEARER_AUDIENCE=erp-provider

# --- Trusted-context HMAC fallback (src/auth/trusted-context.ts) ------------
# Shared secret for signed x-openshapeforge-* internal context headers. Must match
# the signer (scripts/e2e-crud-proof.ts, the e2e harness, k6), which defaults
# to this value. Randomize outside local dev. Unset = all trusted-context
# headers rejected.
OPENSHAPEFORGE_INTERNAL_CONTEXT_SECRET=openshapeforge-local-dev-context-secret

# --- RLS scope resolution (src/auth/identity.ts) ----------------------------
# Comma-separated roles that grant tenant-wide read scope. Unset = no role
# grants tenant scope; sessions fall through to "group"/"self".
#APP_TENANT_BYPASS_ROLES=Platform.TenantAdmin

# --- Tenant control plane (src/control/) ------------------------------------
# The cross-tenant provisioning surface at /api/control/v1. All-or-nothing:
# leave every variable below unset and the routes answer 503 naming what is
# missing; set some but not all and they do the same. There is deliberately no
# partial mode — the dangerous shape is a configured operator login with an
# unset SPI secret, where provisioning writes the database and Keycloak silently
# never happens.
#
# OPERATOR IDENTITY. The CONTROL realm, not the tenant realm above. An operator
# who can create and suspend tenants must not be a user of the realm those
# tenants log into, so these deliberately do NOT reuse
# OPENSHAPEFORGE_API_VERIFY_BEARER_* — pointing them at the tenant realm would
# accept a tenant user's token on the control surface. CLIENT_ID pins `azp`
# rather than `aud`, because the control realm has no resource-server client and
# so no operator token carries an audience at all; without the pin, a token from
# Keycloak's built-in public `admin-cli` client would be accepted.
#OPENSHAPEFORGE_CONTROL_VERIFY_BEARER_ISSUER=http://localhost:8181/realms/openshapeforge-control
#OPENSHAPEFORGE_CONTROL_VERIFY_BEARER_JWKS_URI=http://localhost:8181/realms/openshapeforge-control/protocol/openid-connect/certs
#OPENSHAPEFORGE_CONTROL_VERIFY_BEARER_CLIENT_ID=openshapeforge-admin-gateway

# KEYCLOAK SPI CREDENTIALS. Provisioning reaches the identity-configuration SPI
# in the TENANT realm as the `openshapeforge-auth-api` service account. This is
# structural: the SPI authenticates its bearer against the target realm and
# requires realm-management manage-realm, so a control-realm operator token can
# never call it, and the operator's token is never forwarded. The secret uses the
# same variable name the realm generator emits for that client, so one credential
# has one name across realm import and runtime.
#OPENSHAPEFORGE_CONTROL_KEYCLOAK_BASE_URL=http://localhost:8181
#KEYCLOAK_CLIENT_SECRET_OPENSHAPEFORGE_AUTH_API=openshapeforge-auth-api-secret
# Optional; shown with their defaults.
#OPENSHAPEFORGE_CONTROL_KEYCLOAK_TENANT_REALM=openshapeforge
#OPENSHAPEFORGE_CONTROL_KEYCLOAK_CLIENT_ID=openshapeforge-auth-api
