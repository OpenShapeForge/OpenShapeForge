# Copy to apps/web/.env before `bun run dev:web`.
# Defaults below match the docker-compose.local.yml stack.

# --- Auth (NextAuth + Keycloak) ---------------------------------------------
# Any random string; `openssl rand -base64 32` is fine for local dev.
AUTH_SECRET=openshapeforge-local-dev-auth-secret
# Must match a client in packages/compiler/config/authoring/authorization.yaml.
AUTH_KEYCLOAK_ID=openshapeforge-gateway
# The gateway client's dev-only secret from that same file.
AUTH_KEYCLOAK_SECRET=dev-secret
# Realm name comes from authorization.yaml (`realm.name`); the compose stack
# publishes Keycloak on 8181.
AUTH_KEYCLOAK_ISSUER=http://localhost:8181/realms/openshapeforge
# Set ONLY when the browser and the server reach Keycloak on different hosts
# (e.g. the app runs in a container). Leave it COMMENTED OUT rather than empty:
# the code falls back with `??`, which an empty string satisfies, so
# `AUTH_KEYCLOAK_ISSUER_INTERNAL=` would win over AUTH_KEYCLOAK_ISSUER and
# produce a relative URL. The same applies to every optional var below.
#AUTH_KEYCLOAK_ISSUER_INTERNAL=
AUTH_URL=http://localhost:3000
# Cookies stay non-secure over plain http on localhost.
AUTH_COOKIE_SECURE=false
#AUTH_COOKIE_DOMAIN=

# --- Session store ----------------------------------------------------------
# Required. The session payload lives here; the cookie holds only its id.
REDIS_URL=redis://localhost:6379

# --- API access -------------------------------------------------------------
# apps/api dev server. 127.0.0.1 rather than localhost so Node's fetch does not
# prefer ::1 while the API binds IPv4-only.
OPENSHAPEFORGE_GATEWAY_URL=http://127.0.0.1:3001
OPENSHAPEFORGE_GRAPHQL_GATEWAY_PATH=/api/graphql
# Off by default: server-side GraphQL calls authenticate with signed
# trusted-context headers, so the large Keycloak token stays in the session.
OPENSHAPEFORGE_GRAPHQL_FORWARD_ACCESS_TOKEN=false
# Signs those trusted-context headers. MUST equal apps/api's value of the same
# name, or the API rejects every server-side request.
OPENSHAPEFORGE_INTERNAL_CONTEXT_SECRET=openshapeforge-local-dev-context-secret

# --- Local dev fallbacks ----------------------------------------------------
# The authored dev users carry tenant aliases ("acme"), while apps/api's DB
# sessions require UUIDs. These map the alias onto a real tenant/user id.
# Commented out, not empty — see the note above.
#OPENSHAPEFORGE_DEV_TENANT_ID=
#OPENSHAPEFORGE_DEV_USER_ID=
#OPENSHAPEFORGE_DEV_USER_ROLES=
