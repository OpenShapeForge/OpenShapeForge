{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase0/authorization-config.schema.json",
  "title": "Authorization Config Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind"],

  "$defs": {
    "authorizationGroupNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "realmRoles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "subGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationGroupNode" }
        }
      }
    }
  },

  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "kind": { "type": "string", "const": "authorizationConfig" },

    "realm": {
      "type": "object",
      "description": "Realm-level settings written directly to realm-export.json.",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "sslRequired": { "type": "string", "enum": ["none", "external", "all"] },
        "loginTheme": { "type": "string", "minLength": 1 },
        "accountTheme": { "type": "string", "minLength": 1 },
        "adminTheme": { "type": "string", "minLength": 1 },
        "emailTheme": { "type": "string", "minLength": 1 },
        "registrationAllowed": { "type": "boolean" },
        "loginWithEmailAllowed": { "type": "boolean" },
        "duplicateEmailsAllowed": { "type": "boolean" },
        "resetPasswordAllowed": { "type": "boolean" },
        "editUsernameAllowed": { "type": "boolean" },
        "bruteForceProtected": { "type": "boolean" },
        "organizationsEnabled": { "type": "boolean" },
        "accessTokenLifespan": { "type": "integer", "minimum": 1 },
        "ssoSessionIdleTimeout": { "type": "integer", "minimum": 1 },
        "ssoSessionMaxLifespan": { "type": "integer", "minimum": 1 },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "adminEnabled": { "type": "boolean" },
            "listeners": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string",
          "description": "Legacy (schemaVersion 1): the entity-role client. Prefer `entityRoleClient`.",
          "minLength": 1
        },
        "entityRoleClient": {
          "type": "string",
          "description": "Keycloak client ID that receives the compiler-generated entity client roles.",
          "minLength": 1
        },
        "realm": {
          "type": "object",
          "description": "Legacy (schemaVersion 1): realm-level admin events config. Prefer top-level `realm`.",
          "additionalProperties": false,
          "properties": {
            "eventsEnabled": { "type": "boolean" },
            "adminEventsEnabled": { "type": "boolean" },
            "eventsListeners": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "realmRoles": {
          "type": "object",
          "description": "Legacy (schemaVersion 1): realm role composites. Prefer top-level `realmRoles`.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "includes"],
            "properties": {
              "description": { "type": "string" },
              "includes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              }
            }
          }
        },
        "clients": {
          "type": "array",
          "description": "Clients to emit into realm-export.json. Protocol mappers and non-security defaults come from the generator; redirectUris/webOrigins/secret are security-sensitive and authored here.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["gateway", "bearerOnly", "serviceAccount"] },
              "name": { "type": "string" },
              "secret": {
                "type": "string",
                "description": "Client secret. Use a ${env:VAR} (or ${env:VAR:-fallback}) reference resolved at generate time. A literal value is rejected for non-dev realms; use devSecret for dev-only credentials.",
                "minLength": 1
              },
              "devSecret": {
                "type": "string",
                "description": "Dev-only literal client secret. Honored only on a development realm; generation fails if a non-dev realm carries it.",
                "minLength": 1
              },
              "redirectUris": {
                "type": "array",
                "description": "Explicit redirect-URI allow-list for gateway clients. Required for kind=gateway. A concrete http(s) origin, optionally with a trailing path wildcard (e.g. https://app.example.com/*); a bare '*' or host/scheme wildcard is forbidden (enforced by the generator).",
                "items": { "type": "string", "minLength": 1, "not": { "const": "*" } }
              },
              "webOrigins": {
                "type": "array",
                "description": "Explicit CORS web-origin allow-list for gateway clients. Wildcards ('*') are forbidden.",
                "items": { "type": "string", "minLength": 1, "not": { "pattern": "\\*" } }
              },
              "serviceAccountClientRoles": {
                "type": "object",
                "description": "Client roles granted to this client's own service account (serviceAccount kind only), keyed by clientId. Emitted as a synthetic service-account-<id> user in the realm export.",
                "additionalProperties": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1
                }
              }
            }
          }
        },
        "identityProviders": {
          "type": "array",
          "description": "External identity providers (Keycloak identityProviders[]). Host-authored and host-owned: OSF ships provider implementations, never a provider. Every id, URL, scope and mapping is emitted unchanged; only the generator's security validations (unique aliases, secrets via ${env:VAR} in production, HTTPS endpoints in production, no secret-like keys in config) can reject an entry.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "providerId"],
            "properties": {
              "alias": { "type": "string", "minLength": 1, "description": "Realm-unique alias; also the login-URL segment and the mapper binding key." },
              "providerId": { "type": "string", "minLength": 1, "description": "Keycloak provider type: google, microsoft, github, oidc, saml, apple (bundled provider jar), or an approved custom provider id." },
              "displayName": { "type": "string" },
              "enabled": { "type": "boolean", "description": "Defaults to true." },
              "trustEmail": { "type": "boolean", "description": "Defaults to false." },
              "storeToken": { "type": "boolean", "description": "Defaults to false; keep provider tokens unstored unless a documented use case needs them." },
              "linkOnly": { "type": "boolean", "description": "Defaults to false." },
              "hideOnLogin": { "type": "boolean", "description": "Defaults to false." },
              "firstBrokerLoginFlowAlias": { "type": "string", "minLength": 1 },
              "postBrokerLoginFlowAlias": { "type": "string", "minLength": 1 },
              "config": {
                "type": "object",
                "description": "Non-secret provider config, passed through unchanged (scalars normalized to strings, ${env:VAR} resolved). Keys containing secret, password, privateKey, p8Key or token are refused here; put them in `secrets`.",
                "additionalProperties": { "type": ["string", "number", "boolean"] }
              },
              "secrets": {
                "type": "object",
                "description": "Sensitive provider config keys (clientSecret, …). In production every value must be a ${env:VAR} reference; a literal fails generation.",
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "devSecrets": {
                "type": "object",
                "description": "Development-only literal secrets; override `secrets` in development mode and are refused in production.",
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "mappers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "identityProviderMapper"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "identityProviderMapper": { "type": "string", "minLength": 1, "description": "Keycloak mapper type id, e.g. oidc-user-attribute-idp-mapper." },
                    "config": {
                      "type": "object",
                      "additionalProperties": { "type": ["string", "number", "boolean"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "realmRoles": {
      "type": "object",
      "description": "Realm-level roles. Composites can be explicit per-client or wildcard-expanded from entity-derived roles.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "composite": { "type": "boolean" },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "composites": {
            "type": "object",
            "description": "Per-client composite role mappings.",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "includes": {
            "type": "array",
            "description": "Wildcard patterns (e.g. '*:full') expanded over entity-derived roles at generate time.",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "clientRoles": {
      "type": "object",
      "description": "Hand-authored client roles per clientId. Merged with entity-derived roles at generate time.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },

    "groups": {
      "type": "array",
      "description": "Keycloak group hierarchy for dev/demo. Paths in the export are built as /segment/segment.",
      "items": { "$ref": "#/$defs/authorizationGroupNode" }
    },

    "users": {
      "type": "array",
      "description": "Dev test users. Password is plain-text; suitable only for development realms.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "email": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "password": { "type": "string", "minLength": 1 },
          "tid": { "type": "string", "description": "Tenant id; surfaced on the `tid` and `organization` claims." },
          "realmRoles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "groups": {
            "type": "array",
            "description": "Keycloak group paths; must match emitted group `path` values.",
            "items": { "type": "string", "minLength": 1 }
          },
          "clientRoles": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
