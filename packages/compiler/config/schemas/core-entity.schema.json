{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase0/core-entity.schema.json",
  "title": "Core Entity Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "module",
    "entity",
    "title",
    "language",
    "fields"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "coreEntity"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/localizedText"
        }
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "nl"
      ]
    },
    "labels": {
      "$ref": "#/$defs/localizedText"
    },
    "domains": {
      "type": "array",
      "description": "Optional domain tags used to group entities independently from contexts or profiles.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "retention": {
      "$ref": "#/$defs/retentionPolicy"
    },
    "displayTemplate": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical human-readable template for an instance, e.g. '{{title}}' or '{{street}} {{houseNumber}}'. Placeholders reference entity field keys."
    },
    "filterField": {
      "type": "string",
      "minLength": 1,
      "description": "Field key used when filtering a list of this entity by free-text input (typeahead in pickers). Wires into generated FilterInput with ilike semantics."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "hooks": {
      "type": "object",
      "description": "Lifecycle hooks for custom business logic.",
      "properties": {
        "beforeCreate": {
          "$ref": "#/$defs/hookList"
        },
        "afterCreate": {
          "$ref": "#/$defs/hookList"
        },
        "beforeUpdate": {
          "$ref": "#/$defs/hookList"
        },
        "afterUpdate": {
          "$ref": "#/$defs/hookList"
        },
        "beforeDelete": {
          "$ref": "#/$defs/hookList"
        },
        "afterDelete": {
          "$ref": "#/$defs/hookList"
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Entity-level RBAC permissions (legacy).",
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "create": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "update": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "description": "Entity-level RBAC authorization. Defines roles required for CRUD operations. Used by the compiler to generate GraphQL auth guards and Keycloak role definitions.",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "object",
          "required": ["read"],
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "create": {
              "type": "array",
              "items": { "type": "string" }
            },
            "update": {
              "type": "array",
              "items": { "type": "string" }
            },
            "delete": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "rowAccess": {
          "type": "object",
          "description": "Row-level access filtering. When enabled, the compiler emits a Postgres RLS policy (`FORCE ROW LEVEL SECURITY`) alongside the tenant predicate. Add an `owner` axis to make each row visible only to the user recorded in its owner column, and/or a `group` axis to make each row visible only within the org-unit hierarchy recorded in its group column; without any axis the policy is plain tenant scoping. Owner and group axes are independently combinable (both emit OR-branches). The platform-admin bypass (app.bypass_rls()) and tenant scope (app.has_scope('tenant')) always short-circuit the policy.",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable row-level access filtering for this entity."
            },
            "empty": {
              "type": "string",
              "enum": ["public", "restricted"],
              "default": "public",
              "description": "Behavior when a row's group/owner column IS NULL: 'public' = the NULL-column row is visible tenant-wide (OR-NULL branch emitted); 'restricted' = NULL-column rows are hidden. Defaults to 'public'. Forced to 'restricted' when 'owner' is set. 'restricted' requires an owner or group axis — otherwise there is no confidentiality column to be NULL and the compiler fails closed."
            },
            "owner": {
              "type": "object",
              "description": "Owner-predicated axis. When set, the generated policy adds `\"<column>\" = app.current_user_id()`. Use for per-user data (preferences, notifications, drafts) where each user only sees rows they own. The column must be a uuid field or belongsTo foreignKey on this entity.",
              "additionalProperties": false,
              "required": ["column", "session"],
              "properties": {
                "column": {
                  "type": "string",
                  "description": "Persisted uuid column (or belongsTo foreignKey) on this entity that holds the owner's user id. Must reference a uuid-typed field or relationship foreignKey."
                },
                "session": {
                  "type": "string",
                  "const": "app.current_user_id",
                  "description": "Session identity the owner column is compared against. Only 'app.current_user_id' is accepted — the runtime exposes just the current user id GUC. Per-account session vars are not supported."
                }
              }
            },
            "group": {
              "type": "object",
              "description": "Group-predicated mode. The generated RLS policy adds `\"<column>\" = ANY(<groups-fn>())` where the function is selected by `expand` (descendants→app.current_groups(), exact→app.current_groups_exact(), ancestors→app.current_groups_ancestors()). Use for org-unit / team confidentiality. The column must be a uuid field or belongsTo foreignKey holding the row's owning org-unit id.",
              "additionalProperties": false,
              "required": ["column"],
              "properties": {
                "column": {
                  "type": "string",
                  "description": "Persisted uuid column (or belongsTo foreignKey) on this entity holding the owning org-unit id."
                },
                "expand": {
                  "type": "string",
                  "enum": ["descendants", "ancestors", "exact"],
                  "default": "descendants",
                  "description": "How the user's directly-bound org units expand against the closure at session setup: descendants=see rows of child units, ancestors=see parents', exact=only direct units. Resolved into the per-mode GUC set before the query; the policy compares to the already-expanded set."
                }
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "View definitions for the core entity. Build-time generated into frontend components.",
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/localizedText"
              }
            ]
          }
        },
        "presentations": {
          "$ref": "#/$defs/presentations"
        }
      }
    },
    "rest": {
      "description": "Opt-in generated REST exposure. Absent or false means no REST routes (fail closed). `true` enables all operations under a derived base path; the object form allows per-operation flags and a custom basePath.",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "basePath": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "list": { "type": "boolean" },
                "get": { "type": "boolean" },
                "create": { "type": "boolean" },
                "update": { "type": "boolean" },
                "delete": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "description": "Workflow node generation settings for this entity.",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": { "$ref": "#/$defs/workflowActionConfig" },
                "getOne": { "$ref": "#/$defs/workflowActionConfig" },
                "list": { "$ref": "#/$defs/workflowListActionConfig" },
                "update": { "$ref": "#/$defs/workflowActionConfig" },
                "delete": { "$ref": "#/$defs/workflowActionConfig" },
                "wait": { "$ref": "#/$defs/workflowActionConfig" },
                "awaitAction": { "$ref": "#/$defs/workflowActionConfig" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "en",
          "nl",
          "fr"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "fieldKey": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "validationRule": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {},
        "message": { "$ref": "#/$defs/localizedText" }
      }
    },
    "retentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "mode": {
          "type": "string",
          "enum": ["inline", "policyRef", "fieldOverride"]
        },
        "policy": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": ["record", "field"]
        },
        "inherit": {
          "type": "string",
          "enum": ["entity", "dossier", "none"]
        },
        "jurisdiction": {
          "type": "string"
        },
        "legalBasis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "statutory_obligation",
                "contract",
                "legitimate_interest",
                "consent",
                "public_task",
                "other"
              ]
            },
            "reference": {
              "type": "string"
            }
          }
        },
        "duration": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minimum": { "type": "string" },
                "maximum": { "type": "string" },
                "default": { "type": "string" }
              }
            }
          ]
        },
        "startsFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["createdAt", "updatedAt", "field", "firstNonNull"]
            },
            "field": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": ["keep", "archive", "delete", "anonymize", "mask", "review", "cryptoDelete"]
            },
            "review": {
              "oneOf": [
                { "type": "boolean" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "required": { "type": "boolean" },
                    "queue": { "type": "string" }
                  }
                }
              ]
            }
          }
        },
        "holds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "suspendDestruction": { "type": "boolean" }
          }
        },
        "tenantOverride": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowExtension": { "type": "boolean" },
            "allowShortening": { "type": "boolean" }
          }
        },
        "reason": {
          "$ref": "#/$defs/localizedText"
        }
      }
    },
    "workflowActionConfig": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "readableFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fieldKey"
              }
            },
            "writableFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fieldKey"
              }
            }
          }
        }
      ]
    },
    "workflowListActionConfig": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "readableFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fieldKey"
              }
            },
            "writableFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fieldKey"
              }
            },
            "defaultSort": {
              "type": "object",
              "description": "Default ordering applied when a workflow list node does not specify its own sort.",
              "additionalProperties": false,
              "required": ["field", "direction"],
              "properties": {
                "field": {
                  "$ref": "#/$defs/fieldKey"
                },
                "direction": {
                  "type": "string",
                  "enum": ["asc", "desc"]
                }
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/fieldKey"
        },
        "type": {
          "type": "string",
          "enum": [
            "uuid",
            "string",
            "integer",
            "number",
            "boolean",
            "reference",
            "date",
            "datetime",
            "object",
            "array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "placeholder": {
          "$ref": "#/$defs/localizedText"
        },
        "help": {
          "$ref": "#/$defs/localizedText"
        },
        "semanticType": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "defaultValue": {},
        "localized": {
          "type": "boolean"
        },
        "layoutFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "audit": {
          "type": "boolean"
        },
        "classification": {
          "type": "object",
          "properties": {
            "sensitivity": {
              "type": "string",
              "enum": [
                "public",
                "internal",
                "confidential",
                "pii",
                "bsn"
              ]
            },
            "category": {
              "type": "string"
            }
          }
        },
        "retention": {
          "$ref": "#/$defs/retentionPolicy"
        },
        "hints": {
          "type": "object",
          "properties": {
            "aiInstructions": {
              "type": "string"
            },
            "sourceHint": {
              "type": "string"
            },
            "requirements": {
              "type": "string"
            }
          }
        },
        "suggestions": {
          "type": "object",
          "properties": {
            "sourceField": {
              "type": "string"
            },
            "sourceKey": {
              "type": "string"
            },
            "filter": {
              "type": "object",
              "properties": {
                "semanticType": { "type": "string" },
                "valueType": {
                  "type": "string",
                  "enum": ["string", "number", "boolean", "object", "array"]
                },
                "itemSemanticType": { "type": "string" },
                "fieldType": { "type": "string" }
              }
            }
          }
        },
        "visibility": {
          "type": "object",
          "required": [
            "conditions"
          ],
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "operator"
                ],
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "eq",
                      "neq",
                      "in",
                      "notIn",
                      "gt",
                      "lt",
                      "gte",
                      "lte",
                      "isEmpty",
                      "isNotEmpty"
                    ]
                  },
                  "value": {}
                }
              }
            },
            "logic": {
              "type": "string",
              "enum": [
                "and",
                "or"
              ]
            }
          }
        },
        "computed": {
          "type": "object",
          "required": [
            "expression",
            "dependencies"
          ],
          "properties": {
            "expression": {
              "type": "string"
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": {
              "type": "boolean"
            }
          }
        },
        "workflowInspector": {
          "$ref": "https://openshapeforge.example/schema-common/workflow-inspector.schema.json"
        },
        "options": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "static",
                "referentiedata",
                "remote"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "$ref": "#/$defs/localizedText"
                  }
                }
              }
            },
            "referentieGroep": {
              "type": "string"
            },
            "remoteUrl": {
              "type": "string"
            },
            "valueField": {
              "type": "string"
            },
            "labelField": {
              "type": "string"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "item": {
          "$ref": "#/$defs/field"
        },
        "validation": {
          "type": "object",
          "properties": {
            "required": {
              "oneOf": [
                { "type": "boolean" },
                { "$ref": "#/$defs/validationRule" }
              ]
            },
            "minLength": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "$ref": "#/$defs/validationRule" }
              ]
            },
            "maxLength": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "$ref": "#/$defs/validationRule" }
              ]
            },
            "min": {
              "oneOf": [
                { "type": "number" },
                { "$ref": "#/$defs/validationRule" }
              ]
            },
            "max": {
              "oneOf": [
                { "type": "number" },
                { "$ref": "#/$defs/validationRule" }
              ]
            },
            "pattern": {
              "oneOf": [
                { "type": "string" },
                { "$ref": "#/$defs/validationRule" }
              ]
            },
            "custom": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "message": { "$ref": "#/$defs/localizedText" },
                  "params": { "type": "object" }
                }
              }
            }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "group"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "referentiedata"
              ]
            },
            "group": {
              "type": "string"
            }
          }
        },
        "persisted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "storageClass": {
              "type": "string",
              "enum": [
                "core",
                "profile"
              ]
            }
          }
        },
        "graphqlType": {
          "type": "string",
          "description": "Override the emitted GraphQL type for a non-persisted field. Pairs with a runtime resolver (e.g. ctx.labelService) that returns a value of this type."
        },
        "render": {
          "type": "object",
          "description": "Override the default UI component for this field. If omitted, the component catalog default for the field type is used.",
          "required": [
            "component"
          ],
          "properties": {
            "component": {
              "type": "string",
              "description": "Component name from the component catalog."
            },
            "props": {
              "type": "object",
              "description": "Props to pass to the component."
            }
          }
        },
        "permissions": {
          "type": "object",
          "description": "Field-level RBAC permissions (legacy).",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "authorization": {
          "type": "object",
          "description": "Field-level RBAC authorization. Defines roles required to read or mutate this field.",
          "additionalProperties": false,
          "required": ["roles"],
          "properties": {
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "write": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "presentations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["page", "embedded"] },
          "type": { "type": "string", "enum": ["list", "detail", "form", "summary", "cards"] },
          "itemAction": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "relationship": {
      "type": "object",
