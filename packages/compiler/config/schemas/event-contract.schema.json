{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase1/event-contract.schema.json",
  "title": "Event payload contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "event", "version", "fields"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "eventContract" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$", "maxLength": 150 },
    "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "fields": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "$ref": "https://openshapeforge.example/schema-phase1/field-definition.schema.json" }
    }
  }
}
