{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase1/field-definition.schema.json",
  "title": "Field Definition Schema",
  "$ref": "#/$defs/fieldDefinition",
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string" },
        "nl": { "type": "string" },
        "fr": { "type": "string" }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }] },
        "message": { "$ref": "#/$defs/localizedText" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/validationRule" }]
        },
        "minLength": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/validationRule" }]
        },
        "maxLength": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/validationRule" }]
        },
        "minItems": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/validationRule" }]
        },
        "min": {
          "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/validationRule" }]
        },
        "max": {
          "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/validationRule" }]
        },
        "pattern": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/validationRule" }]
        },
        "format": { "type": "string", "minLength": 1 },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "message": { "$ref": "#/$defs/localizedText" },
              "params": { "type": "object" }
            }
          }
        }
      }
    },
    "fieldOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["static", "referentiedata", "remote", "dynamic", "entity"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "$ref": "#/$defs/localizedText" }
            }
          }
        },
        "source": { "type": "string" },
        "referentieGroep": { "type": "string" },
        "remoteUrl": { "type": "string" },
        "valueField": { "type": "string" },
        "labelField": { "type": "string" }
      },
      "allOf": [{
        "if": { "properties": { "type": { "const": "entity" } }, "required": ["type"] },
        "then": {
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "valueField": { "type": "string", "minLength": 1 },
            "items": false,
            "referentieGroep": false,
            "remoteUrl": false,
            "labelField": false
          }
        }
      }]
    },
    "inverseCollection": {
      "type": "object",
      "additionalProperties": false,
      "description": "How a single entity reference shapes the collection the compiler derives for it on the target entity. Every property is optional: the key defaults to the lower-camel plural of the referencing entity and the label to that entity's labels.",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "label": { "$ref": "#/$defs/localizedText" },
        "ownership": { "enum": ["owned", "reference"] },
        "sortable": { "type": "boolean" },
        "childAuthorization": { "type": "string", "enum": ["owner"] },
        "allowedDefinitions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inverse": {
          "description": "On a single reference: the derived inverse collection, or false to decline one. On a via traversal collection: the key of the referencing field on the target entity.",
          "oneOf": [
            { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
            { "$ref": "#/$defs/inverseCollection" },
            { "const": false }
          ]
        },
        "via": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "ownership": { "enum": ["owned", "reference"] },
        "displayField": { "type": "string", "minLength": 1 },
        "constraints": { "$ref": "#/$defs/relationshipConstraints" }
      }
    },
    "constraintScalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "equalityConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eq"],
      "properties": { "eq": { "$ref": "#/$defs/constraintScalar" } }
    },
    "relationshipAnyConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/equalityConstraint" }
        }
      }
    },
    "relationshipConstraints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/equalityConstraint" },
          { "$ref": "#/$defs/relationshipAnyConstraint" }
        ]
      }
    },
    "cardinality": {
      "oneOf": [
        { "type": "string", "enum": ["single", "collection"] },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "const": "unbounded" }
              ]
            }
          },
          "anyOf": [
            { "properties": { "min": {} }, "required": ["min"] },
            { "properties": { "max": {} }, "required": ["max"] }
          ]
        }
      ]
    },
    "fieldAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "pinned": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "singleton": { "type": "boolean" },
        "visibleProperties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "props": { "type": "object" }
      }
    },
    "fieldDefinition": {
      "type": "object",
      "description": "The canonical closed FieldDefinition shape — what to $ref when a field is used as-is. unevaluatedProperties rather than additionalProperties because only the former sees an allOf branch beside it, which is what lets a use site extend the shape (connector configuration fields add `secret`) without the closure rejecting the addition.",
      "allOf": [{ "$ref": "#/$defs/fieldDefinitionProperties" }],
      "unevaluatedProperties": false
    },
    "fieldDefinitionProperties": {
      "description": "The canonical FieldDefinition property set, left OPEN so a use site can extend it. Extend this one only alongside your own unevaluatedProperties: false — on its own it closes nothing.",
      "type": "object",
      "required": ["key", "osfType"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "osfType": {
          "type": "string",
          "minLength": 1,
          "description": "The one type axis: a base type (string, integer, number, boolean, date, datetime, object), a camelCase osf-type catalog key, or a PascalCase entity name. The compiler derives the base type from the catalog."
        },
        "cardinality": { "$ref": "#/$defs/cardinality" },
        "entityValue": {
          "type": "object", "additionalProperties": false, "required": ["definitionField"],
          "properties": { "definitionField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }, "parameterBindings": { "type": "boolean" } }
        },
        "allowedDefinitions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
        },
        "childAuthorization": {
          "type": "string", "enum": ["owner"],
          "description": "owner: the owner's collection Operations on this field authorize its owned children through the owner's update roles instead of the child entity's own roles."
        },
        "variables": { "type": "string", "enum": ["none", "whole", "template", "both"], "default": "none" },
        "suggestions": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Where the variable suggestions offered for this field come from. Mirrored onto the generated page field so the renderer can offer the right list; pairs with `variables`.",
          "properties": {
            "sourceField": {
              "type": "string",
              "minLength": 1,
              "description": "Key of a sibling field whose value determines the available suggestions."
            },
            "sourceKey": {
              "type": "string",
              "minLength": 1,
              "description": "Fixed suggestion-source key, when the list does not depend on a sibling field."
            }
          }
        },
        "sortable": { "type": "boolean" },
        "required": { "type": "boolean" },
        "readOnly": {
          "type": "boolean",
          "description": "Presentation only: render the field with its display component instead of its input component. Not an API contract — use `immutable` for that."
        },
        "immutable": {
          "type": "boolean",
          "description": "API contract: the field may be set when the record is created and is refused by every generated transport afterwards (REST 400; absent from the GraphQL update input and the MCP update schema). Use it for provenance links and other values that must not be re-pointed once written."
        },
        "writtenBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "API contract: operation contract keys (e.g. `pentest.finding.review`) that are the only writers of this field. The field is absent from the generated create AND update schemas on every transport, and a caller sending it anyway is refused with a message naming these operations. Use it for fields that record that a process took place — a review signed off, a scope approved, a retest concluded — where the operation is the only place the preconditions are checked. Not to be confused with `readOnly`, which selects a display component and enforces nothing. A key no compiled operation answers to fails the build."
        },
        "deriveOnCreate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "transform", "onConflict"],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$",
              "description": "Sibling field whose submitted create value is the derivation source."
            },
            "transform": {
              "const": "slug",
              "description": "Generate a lowercase ASCII slug from the source value."
            },
            "onConflict": {
              "const": "suffix",
              "description": "Resolve a database uniqueness conflict as slug-2, slug-3, and so on."
            }
          },
          "description": "Persist this server-owned field once at create time. Generated create and update inputs omit it on every interface."
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "placeholder": { "$ref": "#/$defs/localizedText" },
        "help": { "$ref": "#/$defs/localizedText" },
        "unit": { "type": "string" },
        "currency": { "type": "string" },
        "value": {},
        "defaultValue": {},
        "validation": { "$ref": "#/$defs/validation" },
        "relationship": { "$ref": "#/$defs/relationship" },
        "options": { "$ref": "#/$defs/fieldOptions" },
        "persisted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "column": { "type": "string" },
            "storageClass": { "type": "string", "enum": ["core", "profile"] }
          }
        },
        "render": { "$ref": "#/$defs/render" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles"],
          "properties": {
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read": { "type": "array", "items": { "type": "string" } },
                "write": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sensitivity"],
          "properties": {
            "sensitivity": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "pii", "bsn"]
            },
            "category": { "type": "string" }
          }
        },
        "retention": { "type": "object" },
        "audit": { "type": "boolean" },
        "hints": { "type": "object" },
        "visibility": { "type": "object" },
        "computed": { "type": "object" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "required": { "type": "boolean" }
          }
        },
        "workflowInspector": {
          "$ref": "https://openshapeforge.example/schema-common/workflow-inspector.schema.json"
        },
        "layoutFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "localized": { "type": "boolean" },
        "shape": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldDefinition" }
        },
        "authoring": { "$ref": "#/$defs/fieldAuthoring" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldDefinition" }
        },
        "item": { "$ref": "#/$defs/fieldDefinition" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cardinality": {
                "type": "object",
                "properties": {
                  "max": {
                    "oneOf": [
                      { "type": "integer", "minimum": 2 },
                      { "const": "unbounded" }
                    ]
                  }
                },
                "required": ["max"]
              }
            },
            "required": ["cardinality"]
          },
          "then": {
            "anyOf": [
              { "properties": { "item": {} }, "required": ["item"] },
              { "properties": { "shape": {} }, "required": ["shape"] },
              { "properties": { "osfType": { "not": { "enum": ["string", "integer", "number", "boolean", "date", "datetime", "object"] } } } },
              { "properties": { "relationship": {} }, "required": ["relationship"] }
            ]
          }
        },
        {
          "if": { "properties": { "sortable": {} }, "required": ["sortable"] },
          "then": {
            "properties": { "cardinality": {} },
            "required": ["cardinality"],
            "anyOf": [
              {
                "properties": {
                  "cardinality": { "const": "collection" }
                }
              },
              {
                "properties": {
                  "cardinality": {
                    "type": "object",
                    "properties": {
                      "max": {
                        "oneOf": [
                          { "type": "integer", "minimum": 2 },
                          { "const": "unbounded" }
                        ]
                      }
                    },
                    "required": ["max"]
                  }
                }
              }
            ]
          }
        },
        {
          "description": "A fieldDefinition semantic value already supplies the complete recursive value contract; children and item would define a second, ambiguous shape.",
          "if": {
            "properties": {
              "osfType": { "const": "fieldDefinition" }
            },
            "required": ["osfType"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "properties": { "children": {} }, "required": ["children"] },
                { "properties": { "item": {} }, "required": ["item"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "osfType": { "const": "fieldDefinition" },
              "authoring": { "type": "object", "properties": { "profile": {} }, "required": ["profile"] }
            },
            "required": ["osfType", "authoring"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "properties": { "required": {} }, "required": ["required"] },
                { "properties": { "children": {} }, "required": ["children"] },
                { "properties": { "item": {} }, "required": ["item"] }
              ]
            }
          }
        }
      ]
    }
  }
}
