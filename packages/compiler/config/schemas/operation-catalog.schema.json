{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase0/operation-catalog.schema.json",
  "title": "Operation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "plugin",
    "operations",
    "interfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "operationCatalog"
    },
    "plugin": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "core-entity.schema.json#/$defs/entityOperationV2"
          },
          {
            "properties": {
              "implementation": {
                "properties": {
                  "type": {
                    "const": "plugin"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "target"
                  ]
                }
              },
              {
                "not": {
                  "properties": {
                    "implementation": {
                      "required": [
                        "action"
                      ]
                    }
                  },
                  "required": [
                    "implementation"
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "rest": {
          "$ref": "core-entity.schema.json#/$defs/entityInterfacesV2/properties/rest"
        },
        "graphql": {
          "$ref": "core-entity.schema.json#/$defs/entityInterfacesV2/properties/graphql"
        },
        "mcp": {
          "$ref": "core-entity.schema.json#/$defs/entityInterfacesV2/properties/mcp"
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "description": "Projects module operations either to standalone pages or to normal provider-backed entity views.",
          "anyOf": [
            { "required": ["pages", "operations"] },
            { "required": ["entities"] }
          ],
          "properties": {
            "pages": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "$ref": "core-entity.schema.json#/$defs/localizedText"
                  },
                  "description": {
                    "$ref": "core-entity.schema.json#/$defs/localizedText"
                  },
                  "icon": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "operations": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "page"
                ],
                "properties": {
                  "page": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "landing": {
                    "type": "boolean",
                    "description": "Runs on page open and shows its result first; only for read operations without required input."
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "entities": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "route", "idField", "displayField", "fields", "columns", "operations"],
                "properties": {
                  "title": { "$ref": "core-entity.schema.json#/$defs/localizedText" },
                  "route": { "type": "string", "pattern": "^/[a-z][a-zA-Z0-9_/:.-]*$" },
                  "recordRoute": { "type": "string", "pattern": "^/[a-z][a-zA-Z0-9_/:.-]*$" },
                  "idField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                  "displayField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                  "fields": {
                    "type": "array", "minItems": 1, "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
                  },
                  "columns": {
                    "type": "array", "minItems": 1, "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
                  },
                  "operations": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["list"],
                    "properties": {
                      "list": { "$ref": "#/$defs/entityRead" },
                      "get": { "$ref": "#/$defs/entityRead" },
                      "collectionActions": { "$ref": "#/$defs/operationKeys" },
                      "recordActions": { "$ref": "#/$defs/operationKeys" }
                    }
                  },
                  "related": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["entity", "label", "route"],
                      "properties": {
                        "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
                        "label": { "$ref": "core-entity.schema.json#/$defs/localizedText" },
                        "route": { "type": "string", "pattern": "^/[a-z][a-zA-Z0-9_/:.-]*$" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
      "operationKeys": {
        "type": "array", "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
      },
      "entityRead": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation"],
        "properties": {
          "operation": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "resultField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "bindings": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
            "additionalProperties": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
          }
        }
      }
    }
}
