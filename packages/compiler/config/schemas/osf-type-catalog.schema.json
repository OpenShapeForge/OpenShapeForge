{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase0/osf-type-catalog.schema.json",
  "title": "Semantic Type Catalog Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "types"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "osfTypeCatalog" },
    "types": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$",
        "description": "Catalog keys are camelCase; PascalCase names are entities, and the seven base types are not catalog entries."
      },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "valueType"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["scalar", "object"],
            "description": "Entity types (kind: entity) and their identity aliases (kind: entityId) are derived from the entity corpus, never authored."
          },
          "label": { "type": "object" },
          "pluralLabel": { "type": "object" },
          "valueType": { "type": "string" },
          "validation": { "type": "object" },
          "options": {
            "$ref": "core-entity.schema.json#/$defs/field/properties/options"
          },
          "schema": {
            "description": "The complete value schema of this type, as a $ref into the bundled field-definition definitions. A type that declares one is projected through it instead of through valueType and shape.",
            "type": "object",
            "required": ["$ref"],
            "additionalProperties": false,
            "properties": {
              "$ref": { "type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$" }
            }
          },
          "lookup": {
            "type": "object",
            "required": ["provider"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string" },
              "remoteUrl": { "type": "string" },
              "searchParam": { "type": "string" },
              "filters": {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number", "boolean"]
                }
              }
            }
          },
          "render": {
            "type": "object",
            "properties": {
              "display": { "type": "string" },
              "input": { "type": "string" }
            }
          },
          "format": { "type": "string" },
          "icon": { "type": "string" },
          "props": { "type": "object" },
          "classification": {
            "type": "object",
            "properties": {
              "sensitivity": {
                "type": "string",
                "enum": ["public", "internal", "confidential", "pii", "bsn"]
              },
              "category": { "type": "string" }
            }
          },
          "retention": {
            "$ref": "core-entity.schema.json#/$defs/retentionPolicy"
          },
          "audit": { "type": "boolean" },
          "hints": {
            "type": "object",
            "properties": {
              "aiInstructions": { "type": "string" },
              "sourceHint": { "type": "string" },
              "requirements": { "type": "string" }
            }
          },
          "entity": { "type": "string" },
          "listUrl": { "type": "string" },
          "displayTemplate": { "type": "string" },
          "filterField": { "type": "string" }
        }
      }
    }
  }
}
