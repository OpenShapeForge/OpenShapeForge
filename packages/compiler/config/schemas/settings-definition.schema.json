{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase0/settings-definition.schema.json",
  "title": "Owner-defined settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "namespace", "settings"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "settingsDefinition" },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)*$",
      "maxLength": 120
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setting" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "stringValue": { "type": "string", "minLength": 1, "maxLength": 255 },
    "base": {
      "type": "object",
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["key"]
    },
    "integer": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "default", "minimum", "maximum"],
          "properties": {
            "key": { "$ref": "#/$defs/key" },
            "description": { "type": "string", "minLength": 1, "maxLength": 500 },
            "type": { "const": "integer" },
            "default": { "type": "integer" },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" }
          }
        }
      ]
    },
    "stringSet": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "default", "allowed"],
          "properties": {
            "key": { "$ref": "#/$defs/key" },
            "description": { "type": "string", "minLength": 1, "maxLength": 500 },
            "type": { "const": "stringSet" },
            "default": {
              "type": "array",
              "items": { "$ref": "#/$defs/stringValue" },
              "uniqueItems": true
            },
            "allowed": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/stringValue" },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "choice": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "default", "choices"],
          "properties": {
            "key": { "$ref": "#/$defs/key" },
            "description": { "type": "string", "minLength": 1, "maxLength": 500 },
            "type": { "const": "choice" },
            "default": { "$ref": "#/$defs/stringValue" },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/stringValue" },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "boolean": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "default"],
          "properties": {
            "key": { "$ref": "#/$defs/key" },
            "description": { "type": "string", "minLength": 1, "maxLength": 500 },
            "type": { "const": "boolean" },
            "default": { "type": "boolean" }
          }
        }
      ]
    },
    "provider": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "capability", "allowedProviders"],
          "properties": {
            "key": { "$ref": "#/$defs/key" },
            "description": { "type": "string", "minLength": 1, "maxLength": 500 },
            "type": { "const": "provider" },
            "capability": { "$ref": "#/$defs/name" },
            "allowedProviders": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/name" },
              "uniqueItems": true
            },
            "default": { "$ref": "#/$defs/name" },
            "enabledBy": { "$ref": "#/$defs/key" }
          }
        }
      ]
    },
    "setting": {
      "oneOf": [
        { "$ref": "#/$defs/integer" },
        { "$ref": "#/$defs/stringSet" },
        { "$ref": "#/$defs/choice" },
        { "$ref": "#/$defs/boolean" },
        { "$ref": "#/$defs/provider" }
      ]
    }
  }
}
