{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshapeforge.example/schema-phase0/settings-provider.schema.json",
  "title": "Settings provider capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "provider", "capabilities"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "settingsProvider" },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    }
  }
}
