// Generated by OpenShapeForge Service Compiler
// Dynamic detail route — resolves entity from URL slug, renders with Suspense

import { Suspense } from "react";
import { notFound } from "next/navigation";
import { getActiveContext, getActiveLang } from "@/lib/server-context";
import { EntityRealtimeRefresh } from "@/components/entity/EntityRealtimeRefresh";
import {
  isEntityForbiddenError,
  resolveEntityLoadErrorMessage,
} from "@/components/entity/entity-page-errors";
import { EntityAccessDeniedView } from "@/components/entity/EntityAccessDeniedView";
import { EntityPageChrome } from "@/components/entity/EntityPageChrome";
import { EntityWorkspacePage } from "@/components/entity/EntityWorkspacePage";
import {
  detailConfigToRendererDefinition,
  resolveDetailPageHeader,
  translateDetailText,
} from "@/components/entity/entity-detail-contract";
import {
  buildEntityDetailRealtimeKey,
  resolveEntityRealtimeResourceType,
} from "@/features/realtime/lib/entity-resource-keys";
import { Renderer } from "@/features/renderer/components/renderer";
import { EntityActionButtons } from "@/features/entity-actions/components/EntityActionButtons";
import { fetchActiveActions } from "@/features/entity-actions/lib/fetch-active-actions";
import { EntityLabelsServer } from "@/features/labels/components/EntityLabelsServer";
import { executeGraphqlRequest } from "@/lib/server/graphql-client";
import { resolveEntity, type EntityManifestEntry } from "@/compiler/entity-manifest";
import { getCachedSession } from "@/lib/cached-session";
import { resolveEntitySlugForRoute } from "@/lib/server/route-authz";
import { rolesGrantOp } from "@/lib/server/compiler-authz";
import { buildEntityActionVisibilityPredicate } from "@/lib/server/entity-action-authz";

type PageProps = {
  params: Promise<{ entity: string; id: string }>;
  searchParams: Promise<{ [key: string]: string | string[] | undefined }>;
};

function DetailSkeleton() {
  return (
    <div className="flex flex-1 flex-col gap-6 p-6">
      <div className="space-y-3">
        <div className="h-10 w-64 animate-pulse rounded-2xl bg-muted/70" />
        <div className="h-5 w-96 max-w-full animate-pulse rounded-2xl bg-muted/70" />
      </div>
      <div className="grid gap-4 lg:grid-cols-[minmax(0,1.8fr)_minmax(280px,0.8fr)]">
        <div className="min-h-[420px] w-full animate-pulse rounded-2xl bg-muted/70" />
        <div className="space-y-4">
          <div className="h-32 w-full animate-pulse rounded-2xl bg-muted/70" />
          <div className="h-48 w-full animate-pulse rounded-2xl bg-muted/70" />
        </div>
      </div>
    </div>
  );
}

function getSingleSearchParamValue(value: string | string[] | undefined): string | undefined {
  return Array.isArray(value) ? value[0] : value;
}

function resolveActiveDetailGroupId(config: any, requestedGroup: string | undefined): string {
  const defaultGroupId = config.defaultGroupId ?? config.groups?.[0]?.id ?? "overview";
  if (!requestedGroup) return defaultGroupId;
  return config.groups?.some((group: any) => group.id === requestedGroup) ? requestedGroup : defaultGroupId;
}

async function DetailContent({
  entry,
  config,
  id,
  lang,
  activeGroupId,
  domains,
  searchParams,
  authzSlug,
}: {
  entry: EntityManifestEntry;
  config: any;
  id: string;
  lang: string;
  activeGroupId: string;
  domains: string[];
  searchParams: { [key: string]: string | string[] | undefined };
  authzSlug: string | null;
}) {
  const baseQuery = config.queriesByGroup[activeGroupId] ?? config.queriesByGroup[config.defaultGroupId];
  const pathnameTemplate =
    typeof config.pathnameTemplate === "string"
      ? config.pathnameTemplate
      : config.pathnameTemplate?.[lang] ?? config.pathnameTemplate?.en ?? "/";
  const pathname = pathnameTemplate.replace(/:id/g, () => id);

  let loadError: string | null = null;
  let entity: Record<string, unknown> | null = null;
  let activeActions: any[] = [];

  try {
    const data = await executeGraphqlRequest<Record<string, unknown>>({
      query: baseQuery,
      variables: { id },
    });
    entity = (data?.[config.queryName] ?? null) as Record<string, unknown> | null;
  } catch (error) {
    loadError = resolveEntityLoadErrorMessage(error, lang);
  }

  if (entity) {
    try {
      activeActions = await fetchActiveActions(entry.entityType, id);
    } catch {
      // Non-critical: entity action support can be absent while generated detail still works.
    }
  }

  if (!entity && !loadError) notFound();

  if (loadError && isEntityForbiddenError(loadError) && !entity) {
    return <EntityAccessDeniedView lang={lang} />;
  }

  const session = await getCachedSession();
  const isActionVisible = buildEntityActionVisibilityPredicate(
    session?.roles,
    authzSlug,
  );
  const header = entity
    ? resolveDetailPageHeader(config, entity, id, lang, isActionVisible)
    : { title: id };
  const badges = [...domains, ...((header as any).badges ?? [])];
  const realtimeResourceType = resolveEntityRealtimeResourceType(entry, config);

  return (
    <EntityPageChrome
      header={{
        ...header,
        badges: badges.length ? badges : undefined,
      }}
      notice={loadError ? { tone: "warning", message: loadError } : undefined}
      headerBadges={
        <EntityLabelsServer
          entityType={entry.entityName}
          entityData={(entity ?? {}) as Record<string, unknown>}
        />
      }
      headerExtra={
        activeActions.length > 0 ? (
          <EntityActionButtons
            activeActions={activeActions}
            entityState={(entity ?? {}) as Record<string, unknown>}
          />
        ) : null
      }
    >
      <EntityRealtimeRefresh
        resourceKeys={[buildEntityDetailRealtimeKey(realtimeResourceType, id)]}
      />
      {entity ? (
        <Renderer
          definition={detailConfigToRendererDefinition(config)}
          lang={lang}
          showTitle={false}
          showDescription={false}
          initialData={entity}
          activeTabId={activeGroupId}
          tabNavigation={{
            pathname,
            searchParams,
            defaultTabId: config.defaultGroupId,
            paramName: "group",
          }}
          tabAriaLabel={translateDetailText(
            { en: "Detail groups", nl: "Detailgroepen" },
            lang,
          )}
        />
      ) : null}
    </EntityPageChrome>
  );
}

export default async function Page({ params, searchParams }: PageProps) {
  const { entity: slug, id } = await params;
  const entry = await resolveEntity(slug);
  if (!entry?.detailConfigs && !entry?.workspaceConfigs) notFound();

  const resolvedSearchParams = await searchParams;
  const requestedGroup = getSingleSearchParamValue(resolvedSearchParams.group);
  const activeType = await getActiveContext();
  const lang = await getActiveLang();
  const authzSlug = resolveEntitySlugForRoute(`/${slug}`);

  // Server-side read gate (mirrors the list page).
  const sessionForRead = await getCachedSession();
  if (
    authzSlug &&
    sessionForRead?.roles &&
    !rolesGrantOp(sessionForRead.roles, "read", authzSlug)
  ) {
    return <EntityAccessDeniedView lang={lang} />;
  }

  if (entry.workspaceConfigs) {
    const workspaceConfig =
      entry.workspaceConfigs[activeType] ??
      entry.workspaceConfigs[Object.keys(entry.workspaceConfigs)[0]];

    if (workspaceConfig?.render) {
      const selectionParam = workspaceConfig.selectionParam ?? "id";
      return (
        <Suspense fallback={<DetailSkeleton />}>
          <EntityWorkspacePage
            entry={entry}
            config={workspaceConfig}
            lang={lang}
            searchParams={{
              ...resolvedSearchParams,
              [selectionParam]: id,
            }}
          />
        </Suspense>
      );
    }
  }

  const detailConfigs = entry.detailConfigs;
  if (!detailConfigs) notFound();
  const config =
    detailConfigs[activeType] ??
    detailConfigs[Object.keys(detailConfigs)[0]];
  if (!config) notFound();

  const activeGroupId = resolveActiveDetailGroupId(config, requestedGroup);

  return (
    <Suspense fallback={<DetailSkeleton />} key={activeGroupId}>
      <DetailContent
        entry={entry}
        config={config}
        id={id}
        lang={lang}
        activeGroupId={activeGroupId}
        domains={entry.domains}
        searchParams={resolvedSearchParams}
        authzSlug={authzSlug}
      />
    </Suspense>
  );
}
