// Generated by OpenShapeForge Service Compiler
// Dynamic edit route — resolves entity from URL slug, fetches data with Suspense

import { Suspense } from "react";
import { notFound } from "next/navigation";
import { getActiveContext, getActiveLang } from "@/lib/server-context";
import { resolveEntityPageActions } from "@/components/entity/entity-page-contract";
import { EntityPageChrome } from "@/components/entity/EntityPageChrome";
import {
  isEntityForbiddenError,
  resolveEntityLoadErrorMessage,
} from "@/components/entity/entity-page-errors";
import { EntityAccessDeniedView } from "@/components/entity/EntityAccessDeniedView";
import { getCachedSession } from "@/lib/cached-session";
import { resolveEntitySlugForRoute } from "@/lib/server/route-authz";
import { rolesGrantOp } from "@/lib/server/compiler-authz";
import { buildEntityActionVisibilityPredicate } from "@/lib/server/entity-action-authz";
import { Renderer } from "@/features/renderer/components/renderer";
import { translateRendererText } from "@/features/renderer/form-definition";
import {
  generatedFormConfigToRendererDefinition,
} from "@/features/renderer/runtime/generated-form-interop";
import { resolveEntity, type EntityManifestEntry } from "@/compiler/entity-manifest";

type PageProps = {
  params: Promise<{ entity: string; id: string }>;
};

function EditSkeleton() {
  return (
    <div className="flex flex-1 flex-col gap-6 p-6">
      <div className="space-y-3">
        <div className="h-10 w-64 animate-pulse rounded-2xl bg-muted/70" />
      </div>
      <div className="space-y-4">
        <div className="h-16 w-full animate-pulse rounded-2xl bg-muted/70" />
        <div className="h-16 w-full animate-pulse rounded-2xl bg-muted/70" />
        <div className="h-16 w-full animate-pulse rounded-2xl bg-muted/70" />
        <div className="h-16 w-full animate-pulse rounded-2xl bg-muted/70" />
      </div>
    </div>
  );
}

async function EditContent({
  rawConfig,
  rendererConfig,
  id,
  lang,
  getAction,
  updateAction,
  domains,
  authzSlug,
}: {
  rawConfig: any;
  rendererConfig: any;
  id: string;
  lang: string;
  getAction: EntityManifestEntry["actions"]["get"];
  updateAction: EntityManifestEntry["actions"]["update"];
  domains: string[];
  authzSlug: string | null;
}) {
  let loadError: string | null = null;
  let entity = null;

  try {
    entity = await getAction(id);
  } catch (error) {
    loadError = resolveEntityLoadErrorMessage(error, lang);
  }

  if (loadError && isEntityForbiddenError(loadError)) {
    return <EntityAccessDeniedView lang={lang} />;
  }

  if (!entity && !loadError) notFound();

  const session = await getCachedSession();
  const isActionVisible = buildEntityActionVisibilityPredicate(
    session?.roles,
    authzSlug,
  );

  return (
    <EntityPageChrome
      header={{
        title: translateRendererText(rawConfig.title, lang),
        badges: domains.length ? domains : undefined,
        actions: resolveEntityPageActions(rawConfig.actions, lang, {
          routes: rawConfig.routes,
          entityId: id,
          isActionVisible,
        }),
      }}
      notice={loadError ? { tone: "warning", message: loadError } : undefined}
    >
      {entity ? (
        <Renderer
          definition={rendererConfig}
          lang={lang}
          showTitle={false}
          showDescription={false}
          action={updateAction}
          initialData={entity}
          id={id}
        />
      ) : null}
    </EntityPageChrome>
  );
}

export default async function Page({ params }: PageProps) {
  const { entity: slug, id } = await params;
  const entry = await resolveEntity(slug);
  if (!entry?.editFormConfigBases) notFound();

  const activeType = await getActiveContext();
  const lang = await getActiveLang();
  const rawConfig =
    entry.editFormConfigBases[activeType] ??
    entry.editFormConfigBases[Object.keys(entry.editFormConfigBases)[0]];

  if (!rawConfig) notFound();

  // Server-side gate: deny rendering the form when persona cannot perform
  // the update op authored on the entity. Otherwise the form would render
  // and only fail on submit, which makes E2E assertions noisy.
  const authzSlug = resolveEntitySlugForRoute(`/${slug}`);
  const session = await getCachedSession();
  if (
    authzSlug &&
    session?.roles &&
    !rolesGrantOp(session.roles, "update", authzSlug)
  ) {
    return <EntityAccessDeniedView lang={lang} />;
  }

  // Resolve locale-aware success route from the entity's detail route
  const detailRoute = entry.routes.detail;
  const successRoute = detailRoute
    ? (typeof detailRoute === "string" ? detailRoute : detailRoute[lang] ?? detailRoute.en ?? "/")
    : rawConfig.successRoute;
  const localizedConfig = { ...rawConfig, successRoute };

  const rendererConfig = generatedFormConfigToRendererDefinition(localizedConfig, {
    id: `generated-form-${activeType}`,
    metadata: { compiler: { context: activeType } },
  });

  return (
    <Suspense fallback={<EditSkeleton />}>
      <EditContent
        rawConfig={localizedConfig}
        rendererConfig={rendererConfig}
        id={id}
        lang={lang}
        getAction={entry.actions.get}
        updateAction={entry.actions.update}
        domains={entry.domains}
        authzSlug={authzSlug}
      />
    </Suspense>
  );
}
