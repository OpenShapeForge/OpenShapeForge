type PageProps = {
  params: Promise<{ entity: string }>;
  searchParams: Promise<{ [key: string]: string | string[] | undefined }>;
};

/**
 * URL-state key for a generated entity list. Server and client use the same
 * value so that what the page reads from `searchParams` matches what the
 * client hook writes back via `router.replace`. Per-entity to keep multiple
 * lists from colliding when grouped on the same route.
 */
function buildGeneratedListTableId(slug: string): string {
  return `entity-list:${slug}`;
}

function ListSkeleton() {
  return (
    <div className="space-y-2 p-1">
      {Array.from({ length: 8 }).map((_, i) => (
        <div key={i} className="h-12 animate-pulse rounded-lg bg-muted/70" />
      ))}
    </div>
  );
}

async function ListData({
  config,
  lang,
  listAction,
  regionLabel,
  tableId,
  filter,
}: {
  config: any;
  lang: string;
  listAction: EntityManifestEntry["actions"]["list"];
  regionLabel: string;
  tableId: string;
  filter: Record<string, unknown> | undefined;
}) {
  let loadError: string | null = null;
  let data:
    | {
        pageInfo?: { hasNextPage?: boolean; endCursor?: string | null };
        totalCount?: number;
      }
    | undefined;
  let rows: Record<string, unknown>[] = [];

  try {
    data = await listAction({
      query: config.query,
      sort: config.defaultSort
        ? { field: config.defaultSort.key, direction: config.defaultSort.direction }
        : undefined,
      first: ENTITY_LIST_PAGE_SIZE,
      filter,
    });

    rows = mapConnectionRows(data, config.columns);

    return (
      <GeneratedListClient
        config={config}
        lang={lang}
        listAction={listAction}
        initialRows={rows}
        initialEndCursor={data?.pageInfo?.endCursor ?? null}
        initialHasNextPage={Boolean(data?.pageInfo?.hasNextPage)}
        initialTotalCount={data?.totalCount ?? rows.length}
        regionLabel={regionLabel}
        tableId={tableId}
      />
    );
  } catch (error) {
    loadError = resolveEntityLoadErrorMessage(error, lang);
  }

  if (loadError) {
    if (isEntityForbiddenError(loadError)) {
      return <EntityAccessDeniedView lang={lang} entityLabel={regionLabel} />;
    }
    return (
      <div className="rounded-lg border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-800 dark:border-yellow-900/50 dark:bg-yellow-900/10 dark:text-yellow-200">
        {loadError}
      </div>
    );
  }

  return null;
}

export default async function Page({ params, searchParams }: PageProps) {
  const { entity: slug } = await params;
  const entry = await resolveEntity(slug);
  if (!entry?.listConfigs && !entry?.workspaceConfigs) notFound();

  const activeType = await getActiveContext();
  const lang = await getActiveLang();
  const resolvedSearchParams = await searchParams;

  // Server-side read gate. The generated CRUD layer only enforces tenant
  // scoping today; per-entity read roles live in the entity YAML and the UI
  // honors them here so a denied persona sees the access-denied view instead
  // of an empty table or a generic load error.
  const authzSlugForRead = resolveEntitySlugForRoute(`/${slug}`);
  const sessionForRead = await getCachedSession();
  if (
    authzSlugForRead &&
    sessionForRead?.roles &&
    !rolesGrantOp(sessionForRead.roles, "read", authzSlugForRead)
  ) {
    return <EntityAccessDeniedView lang={lang} />;
  }

  if (entry.workspaceConfigs) {
    const workspaceConfig =
      entry.workspaceConfigs[activeType] ??
      entry.workspaceConfigs[Object.keys(entry.workspaceConfigs)[0]];

    if (workspaceConfig && !workspaceConfig.render) {
      return (
        <Suspense fallback={<ListSkeleton />}>
          <EntityWorkspacePage
            entry={entry}
            config={workspaceConfig}
            lang={lang}
            searchParams={resolvedSearchParams}
          />
        </Suspense>
      );
    }
  }

  const listConfigs = entry.listConfigs;
  if (!listConfigs) notFound();
  const config =
    listConfigs[activeType] ??
    listConfigs[Object.keys(listConfigs)[0]];
  if (!config) notFound();
  const realtimeResourceType = resolveEntityRealtimeResourceType(entry, config);
  const pageTitle = t(config.title, lang);

  const tableId = buildGeneratedListTableId(slug);
  const tableState = readTableStateFromSearchParams<GeneratedListTableFilters>(
    resolvedSearchParams,
    {
      tableId,
      defaultFilters: DEFAULT_GENERATED_LIST_FILTERS,
    },
  );
  const filter = buildGeneratedListFilter(config, tableState);

  const session = await getCachedSession();
  const authzSlug = resolveEntitySlugForRoute(`/${slug}`);
  const isActionVisible = buildEntityActionVisibilityPredicate(
    session?.roles,
    authzSlug,
  );

  return (
    <EntityPageChrome
      header={{
        title: pageTitle,
        subtitle: config.subtitle ? t(config.subtitle, lang) : undefined,
        badges: entry.domains.length ? entry.domains : undefined,
        actions: resolveEntityPageActions(config.actions, lang, {
          routes: config.routes,
          isActionVisible,
        }),
      }}
    >
      <EntityRealtimeRefresh
        resourceKeys={[buildEntityListRealtimeKey(realtimeResourceType, `generated:${activeType}`)]}
      />
      <Suspense fallback={<ListSkeleton />}>
        <ListData
          config={config}
          lang={lang}
          listAction={entry.actions.list}
          regionLabel={pageTitle}
          tableId={tableId}
          filter={filter}
        />
      </Suspense>
    </EntityPageChrome>
  );
}
