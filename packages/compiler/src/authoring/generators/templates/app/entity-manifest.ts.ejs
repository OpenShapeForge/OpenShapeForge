// Entity manifest dispatcher — maps URL slugs to entity manifest shard loaders.
//
// Each entity lives in its own shard under ./entity-manifests/<slug>.ts. Shards
// are loaded on demand via dynamic import so the server module cache only
// retains entities the user has actually visited (instead of all ~100+ at
// startup, when this used to be one monolithic barrel).
//
// Page configs (list/detail/workspace/create-form/edit-form) are NOT emitted as
// `.ts` files anymore — they live in platform.entity_page_configs and are
// fetched over GraphQL the first time a slug is resolved, then merged into the
// shard entry and memoized in `shardCache`. This module is server-only (it is
// imported exclusively by SSR pages); the GraphQL client below is `server-only`.

import { executeGraphqlRequest } from "@/lib/server/graphql-client";

export type EntityManifestEntry = {
  entityName: string;
  authoringEntitySlug: string;
  entityType: string;
  realtimeResourceType: string;
  domains: string[];
  routes: Record<string, Record<string, string> | string>;
  listConfigs: Record<string, any> | null;
  detailConfigs: Record<string, any> | null;
  workspaceConfigs: Record<string, any> | null;
  createFormConfigBases: Record<string, any> | null;
  editFormConfigBases: Record<string, any> | null;
  actions: {
    list: (...args: any[]) => Promise<any>;
    get: (id: string, options?: any) => Promise<any>;
    create: (input: Record<string, unknown>) => Promise<any>;
    update: (input: Record<string, unknown>) => Promise<any>;
    delete: (id: string) => Promise<any>;
  };
};

type ShardLoader = () => Promise<{ default: EntityManifestEntry }>;

// Slug → loader. The static `import()` calls are explicit so Turbopack /
// webpack can match each one to a separate chunk; never collapse this into a
// computed expression.
const entityShardLoaders: Record<string, ShardLoader> = {
<% for (const [slug, shardName] of slugMappings) { -%>
  "<%- slug %>": () => import("./entity-manifests/<%- shardName %>"),
<% } -%>
};

const shardCache = new Map<string, EntityManifestEntry>();

type EntityPageConfigResult = {
  listConfigs: Record<string, any> | null;
  detailConfigs: Record<string, any> | null;
  workspaceConfigs: Record<string, any> | null;
  createFormConfigBases: Record<string, any> | null;
  editFormConfigBases: Record<string, any> | null;
};

const ENTITY_PAGE_CONFIGS_QUERY = `query ($entitySlug: String!) {
  entityPageConfigs(entitySlug: $entitySlug) {
    listConfigs
    detailConfigs
    workspaceConfigs
    createFormConfigBases
    editFormConfigBases
  }
}`;

export async function resolveEntity(
  slug: string,
): Promise<EntityManifestEntry | undefined> {
  const cached = shardCache.get(slug);
  if (cached) return cached;

  const loader = entityShardLoaders[slug];
  if (!loader) return undefined;

  const mod = await loader();
  const entry = mod.default;

  // Page configs no longer ship as generated `.ts` files; fetch them from the
  // platform.entity_page_configs catalog over GraphQL keyed by the entity's
  // authoring slug. `queryCache` dedupes concurrent SSR reads for the same slug.
  try {
    const data = await executeGraphqlRequest<{
      entityPageConfigs: EntityPageConfigResult | null;
    }>({
      query: ENTITY_PAGE_CONFIGS_QUERY,
      variables: { entitySlug: entry.authoringEntitySlug },
      queryCache: true,
    });
    const configs = data?.entityPageConfigs;
    if (configs) {
      entry.listConfigs = configs.listConfigs ?? null;
      entry.detailConfigs = configs.detailConfigs ?? null;
      entry.workspaceConfigs = configs.workspaceConfigs ?? null;
      entry.createFormConfigBases = configs.createFormConfigBases ?? null;
      entry.editFormConfigBases = configs.editFormConfigBases ?? null;
      // Cache ONLY after a successful config fetch so a transient API failure
      // never poisons the slug for the process lifetime — the next request retries.
      shardCache.set(slug, entry);
    } else {
      console.warn(
        `[entity-manifest] page configs missing for ${entry.authoringEntitySlug}; not caching`,
      );
    }
  } catch (error) {
    // Leave config fields null and do NOT cache on failure; page components call
    // notFound() when their needed config is null, and the next request retries.
    console.warn(
      `[entity-manifest] page configs fetch failed for ${entry.authoringEntitySlug}: ${
        error instanceof Error ? error.message : String(error)
      }`,
    );
  }

  return entry;
}

/** All slugs registered in the manifest. */
export function listEntityManifestSlugs(): string[] {
  return Object.keys(entityShardLoaders);
}

