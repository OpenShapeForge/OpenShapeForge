// Generated by OpenShapeForge Service Compiler
<%
  const entityLower = contract.entity.name.toLowerCase();
-%>

import { notFound } from "next/navigation";
import { getActiveContext, getActiveLang } from "@/lib/server-context";
import { resolveEntityPageActions } from "@/components/entity/entity-page-contract";
import { EntityPageChrome } from "@/components/entity/EntityPageChrome";
import { resolveEntityLoadErrorMessage } from "@/components/entity/entity-page-errors";
import { Renderer } from "@/features/renderer/components/renderer";
import { translateRendererText } from "@/features/renderer/form-definition";
import { get<%= contract.entity.name %>, update<%= contract.entity.name %> } from "@/actions/generated/<%= entityLower %>";

const entityDomains: string[] = <%- JSON.stringify(contract.entity.domains) %>;

export type GeneratedEditPageProps = {
  params: Promise<{ id: string }>;
};

export async function render<%= contract.entity.name %>EditPage(
  configs: Record<string, any>,
  { params }: GeneratedEditPageProps,
) {
  const { id } = await params;
  const activeType = await getActiveContext();
  const lang = await getActiveLang();
  const config = configs[activeType] ?? configs[Object.keys(configs)[0]];

  if (!config) {
    return null;
  }

  let loadError: string | null = null;
  let entity = null;

  try {
    entity = await get<%= contract.entity.name %>(id);
  } catch (error) {
    loadError = resolveEntityLoadErrorMessage(error, lang);
  }

  if (!entity && !loadError) notFound();

  return (
    <EntityPageChrome
      header={{
        title: translateRendererText(config.title, lang),
        badges: entityDomains.length ? entityDomains : undefined,
        actions: resolveEntityPageActions(config.actions, lang, {
          routes: config.routes,
          entityId: id,
        }),
      }}
      notice={loadError ? { tone: "warning", message: loadError } : undefined}
    >
      {entity ? (
        <Renderer
          definition={config}
          lang={lang}
          showTitle={false}
          showDescription={false}
          action={update<%= contract.entity.name %>}
          initialData={entity}
          id={id}
        />
      ) : null}
    </EntityPageChrome>
  );
}
