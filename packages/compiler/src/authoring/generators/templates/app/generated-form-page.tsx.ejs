// Generated by OpenShapeForge Service Compiler
<%
  const entityLower = contract.entity.name.toLowerCase();
-%>

import { getActiveContext, getActiveLang } from "@/lib/server-context";
import { resolveEntityPageActions } from "@/components/entity/entity-page-contract";
import { EntityPageChrome } from "@/components/entity/EntityPageChrome";
import { Renderer } from "@/features/renderer/components/renderer";
import { translateRendererText } from "@/features/renderer/form-definition";
import { create<%= contract.entity.name %> } from "@/actions/generated/<%= entityLower %>";

const entityDomains: string[] = <%- JSON.stringify(contract.entity.domains) %>;

export async function render<%= contract.entity.name %>CreatePage(configs: Record<string, any>) {
  const activeType = await getActiveContext();
  const lang = await getActiveLang();
  const config = configs[activeType] ?? configs[Object.keys(configs)[0]];

  if (!config) {
    return null;
  }

  return (
    <EntityPageChrome
      header={{
        title: translateRendererText(config.title, lang),
        badges: entityDomains.length ? entityDomains : undefined,
        actions: resolveEntityPageActions(config.actions, lang, {
          routes: config.routes,
        }),
      }}
    >
      <Renderer
        definition={config}
        lang={lang}
        showTitle={false}
        showDescription={false}
        action={create<%= contract.entity.name %>}
      />
    </EntityPageChrome>
  );
}
