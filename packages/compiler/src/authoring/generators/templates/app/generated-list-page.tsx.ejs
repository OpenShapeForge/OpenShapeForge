// Generated by OpenShapeForge Service Compiler
// Per-entity shared list page — composes DataTable + useInfiniteList against
// the compiled list-config. Paired with entity-list.tsx (route wrapper).
<%
  const entityLower = contract.entity.name.toLowerCase();
  const entityName = contract.entity.name;
-%>

import { Suspense } from "react";
import { getActiveContext, getActiveLang, t } from "@/lib/server-context";
import { list<%= gql.queries.list.name.charAt(0).toUpperCase() + gql.queries.list.name.slice(1) %> } from "@/actions/generated/<%= entityLower %>";
import { ENTITY_LIST_PAGE_SIZE, mapConnectionRows } from "@/components/entity/entity-list-rows";
import { resolveEntityLoadErrorMessage } from "@/components/entity/entity-page-errors";
import { resolveEntityPageActions } from "@/components/entity/entity-page-contract";
import { EntityPageChrome } from "@/components/entity/EntityPageChrome";
import GeneratedListClient from "<%- clientImportPath %>";

const entityDomains: string[] = <%- JSON.stringify(contract.entity.domains) %>;

function ListSkeleton() {
  return (
    <div className="space-y-2 p-1">
      {Array.from({ length: 8 }).map((_, i) => (
        <div key={i} className="h-12 animate-pulse rounded-lg bg-muted/70" />
      ))}
    </div>
  );
}

async function ListData({
  config,
  lang,
}: {
  config: any;
  lang: string;
}) {
  let loadError: string | null = null;
  let data:
    | {
        pageInfo?: { hasNextPage?: boolean; endCursor?: string | null };
        totalCount?: number;
      }
    | undefined;
  let rows: Record<string, unknown>[] = [];

  try {
    data = await list<%= gql.queries.list.name.charAt(0).toUpperCase() + gql.queries.list.name.slice(1) %>({
      query: config.query,
      sort: config.defaultSort
        ? { field: config.defaultSort.key, direction: config.defaultSort.direction }
        : undefined,
      first: ENTITY_LIST_PAGE_SIZE,
    });

    rows = mapConnectionRows(data, config.columns);

    return (
      <GeneratedListClient
        config={config}
        lang={lang}
        listAction={list<%= gql.queries.list.name.charAt(0).toUpperCase() + gql.queries.list.name.slice(1) %>}
        initialRows={rows}
        initialEndCursor={data?.pageInfo?.endCursor ?? null}
        initialHasNextPage={Boolean(data?.pageInfo?.hasNextPage)}
        initialTotalCount={data?.totalCount ?? rows.length}
      />
    );
  } catch (error) {
    loadError = resolveEntityLoadErrorMessage(error, lang);
  }

  if (loadError) {
    return (
      <div className="rounded-lg border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-800 dark:border-yellow-900/50 dark:bg-yellow-900/10 dark:text-yellow-200">
        {loadError}
      </div>
    );
  }

  return null;
}

export async function render<%= entityName %>ListPage(configs: Record<string, any>) {
  const activeType = await getActiveContext();
  const lang = await getActiveLang();
  const config = configs[activeType] ?? configs[Object.keys(configs)[0]];

  return (
    <EntityPageChrome
      header={{
        title: t(config.title, lang),
        subtitle: config.subtitle ? t(config.subtitle, lang) : undefined,
        badges: entityDomains.length ? entityDomains : undefined,
        actions: resolveEntityPageActions(config.actions, lang, {
          routes: config.routes,
        }),
      }}
    >
      <Suspense fallback={<ListSkeleton />}>
        <ListData config={config} lang={lang} />
      </Suspense>
    </EntityPageChrome>
  );
}
