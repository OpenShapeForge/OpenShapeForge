// Generated by OpenShapeForge Service Compiler
// Server actions for <%= contract.entity.name %>, read through its canonical list/get Operations
"use server";
<%
  const gql = contract.graphql;
  const typeName = gql.typeName;
  const listFnName = `list${gql.queries.list.name.charAt(0).toUpperCase()}${gql.queries.list.name.slice(1)}`;
-%>
import {
  executeGraphqlRequest,
  isGraphqlProxyError,
  profileForGraphqlQuery,
} from "@/lib/server/graphql-client";

const LIST_QUERY = <%- JSON.stringify(queries.list) %>;
const GET_QUERY = <%- JSON.stringify(queries.get) %>;
// The query capabilities the source list Operation declares. Its input schema
// refuses anything else, so an unsupported filter or sort fails here, visibly.
const FILTER_FIELDS = new Set<string>(<%- JSON.stringify(source.filterFields) %>);
const SORT_FIELDS = new Set<string>(<%- JSON.stringify(source.sortFields) %>);

// The get Operation answers a record outside the caller's organization, or one
// that does not exist, with its declared NOT_FOUND error. Read that as "no
// record", as a generated CRUD read returns null, rather than as a transport
// failure; any other 404 still surfaces.
function isRecordNotFound(error: unknown): boolean {
  if (!isGraphqlProxyError(error, 404)) return false;
  const errors = (error.payload as { errors?: Array<{ extensions?: { code?: unknown } }> } | undefined)?.errors;
  return Boolean(errors?.some((entry) => entry.extensions?.code === "NOT_FOUND"));
}

export async function get<%= typeName %>(id: string, options?: { query?: string }) {
  const query = options?.query ?? GET_QUERY;
  try {
    const response = await executeGraphqlRequest<{
      <%= source.getField %>?: { data?: Record<string, unknown> | null } | null;
    }>({
      query,
      profile: profileForGraphqlQuery(query),
      variables: { input: { id } },
    });
    return response?.<%= source.getField %>?.data ?? null;
  } catch (error) {
    if (isRecordNotFound(error)) return null;
    throw error;
  }
}

export async function <%= listFnName %>(options?: {
  filter?: Record<string, unknown>;
  sort?: { field: string; direction: string };
  first?: number;
  after?: string;
  query?: string;
}) {
  const query = options?.query ?? LIST_QUERY;
  const input: Record<string, unknown> = { first: options?.first ?? 25 };
  if (options?.after) input.after = options.after;
  if (options?.sort) {
    if (!SORT_FIELDS.has(options.sort.field)) {
      throw new Error(`VALIDATION: <%= contract.entity.name %> cannot be sorted by ${options.sort.field}.`);
    }
    input.sortField = options.sort.field;
    input.sortDirection = options.sort.direction;
  }
  for (const [key, value] of Object.entries(options?.filter ?? {})) {
    if (!FILTER_FIELDS.has(key) || typeof value !== "string") {
      throw new Error(`VALIDATION: <%= contract.entity.name %> cannot be filtered by ${key}.`);
    }
    input[key] = value;
  }
  const response = await executeGraphqlRequest<{
    <%= source.listField %>?: {
      items?: Array<Record<string, unknown>>;
      nextCursor?: string | null;
      totalCount?: number;
    } | null;
  }>({
    query,
    profile: profileForGraphqlQuery(query),
    variables: { input },
  });
  const collection = response?.<%= source.listField %>;
  return {
    edges: (collection?.items ?? []).map((node, index) => ({ node, cursor: String(index) })),
    pageInfo: { hasNextPage: Boolean(collection?.nextCursor), endCursor: collection?.nextCursor ?? null },
    totalCount: collection?.totalCount ?? 0,
  };
}
