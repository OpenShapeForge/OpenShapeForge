    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "graphql": "^16.0.0",
    "graphql-yoga": "^5.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
