{
  "name": "@openshapeforge/operations",
  "version": "0.2.0",
  "description": "Transport-independent operation results and availability offers for OpenShapeForge.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenShapeForge/OpenShapeForge.git",
    "directory": "packages/operations"
  },
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.0"
  }
}
