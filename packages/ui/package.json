{
  "name": "@openshapeforge/ui",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "description": "Design-system primitives consumed by the compiler-generated web app. Tokens under src/tokens are hand-maintained CSS custom properties; components consume those tokens.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./avatar": {
      "types": "./src/components/avatar.tsx",
      "default": "./src/components/avatar.tsx"
    },
    "./base-layout": {
      "types": "./src/components/base-layout.tsx",
      "default": "./src/components/base-layout.tsx"
    },
    "./button": {
      "types": "./src/components/button.tsx",
      "default": "./src/components/button.tsx"
    },
    "./case-check": {
      "types": "./src/components/case-check.tsx",
      "default": "./src/components/case-check.tsx"
    },
    "./chip": {
      "types": "./src/components/chip.tsx",
      "default": "./src/components/chip.tsx"
    },
    "./datascreen-relations": {
      "types": "./src/components/datascreen-relations.tsx",
      "default": "./src/components/datascreen-relations.tsx"
    },
    "./relation-detail-screen": {
      "types": "./src/components/relation-detail-screen.tsx",
      "default": "./src/components/relation-detail-screen.tsx"
    },
    "./entity-header": {
      "types": "./src/components/entity-header.tsx",
      "default": "./src/components/entity-header.tsx"
    },
    "./list-overview": {
      "types": "./src/components/list-overview.tsx",
      "default": "./src/components/list-overview.tsx"
    },
    "./list-table": {
      "types": "./src/components/list-table.tsx",
      "default": "./src/components/list-table.tsx"
    },
    "./separator": {
      "types": "./src/components/separator.tsx",
      "default": "./src/components/separator.tsx"
    },
    "./sidebar-category": {
      "types": "./src/components/sidebar-category.tsx",
      "default": "./src/components/sidebar-category.tsx"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tokens.css": "./src/tokens/index.css",
    "./tooltip": {
      "types": "./src/components/tooltip.tsx",
      "default": "./src/components/tooltip.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.0"
  }
}
